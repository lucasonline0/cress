{
  "name": "cress",
  "version": "0.1.0",
  "description": "Local-first inventory of NestJS route access declarations",
  "type": "module",
  "bin": {
    "cress": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "scan:example": "tsx src/cli.ts scan test/fixtures/nest-app/src",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "demo:diff": "node scripts/demo.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
