{
  "name": "cress",
  "version": "0.3.0",
  "description": "Local-first exploration of API authorization declarations",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "cress": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "scan:example": "tsx src/cli.ts scan test/fixtures/nest-app/src",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "demo:diff": "node scripts/demo.mjs",
    "desktop:build": "node desktop/build.mjs",
    "desktop:dev": "npm run desktop:build && electron desktop-dist/main/main.cjs",
    "desktop:typecheck": "tsc -p desktop/tsconfig.json",
    "desktop:smoke": "npm run desktop:build && node desktop/test/gui.cjs",
    "desktop:package": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/napi": "^0.51.3",
    "commander": "^12.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "main": "desktop-dist/main/main.cjs",
  "build": {
    "appId": "org.cress.desktop",
    "productName": "Cress",
    "asar": false,
    "files": [
      "desktop-dist/**/*",
      "test/fixtures/nest-app/src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/brand/icon_app.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "icon": "assets/brand/icon_app.png"
  },
  "desktopName": "cress.desktop"
}
